{
  "manifest_version": 3,
  "name": "FNANDO: TikTok e YouTube pelo Chrome",
  "version": "1.2.0",
  "description": "Pega na central do FNANDO (localhost:4322) o próximo corte do TikTok (e do YouTube, além da cota da API) e publica pelo Studio, no Chrome onde as contas do FNANDO estão logadas.",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:4322/*",
    "https://www.tiktok.com/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "FNANDO: TikTok pelo Chrome",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  }
}